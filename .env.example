# ==============================================================================
# Q-RAKSHAK: Master Environment Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server & Network Configuration
# ------------------------------------------------------------------------------
QMED_DB_MODE=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1
VITE_BACKEND_ORIGIN=http://localhost:8000
VITE_APP_TITLE=Q-RAKSHAK Quantum Clinical OS

# ------------------------------------------------------------------------------
# 3. Security, Encryption & API Keys
# ------------------------------------------------------------------------------
SECRET_KEY=your-secure-random-256-bit-secret-key-here
JWT_SECRET=your-secure-random-256-bit-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=86400
ACCESS_TOKEN_EXPIRE_MINUTES=480
API_KEY=replace-with-a-cryptographically-random-api-key

# ------------------------------------------------------------------------------
# 4. Pre-Configured Role Authority Credentials (Demo & Testing)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin.audit
ADMIN_PASSWORD=admin123

CLINICIAN_USERNAME=dr.aryan
CLINICIAN_PASSWORD=clinician123

RESEARCHER_USERNAME=priya.qml
RESEARCHER_PASSWORD=quantum123

PATIENT_USERNAME=alex.patient
PATIENT_PASSWORD=patient123

# ------------------------------------------------------------------------------
# 5. Quantum Machine Learning & Hardware Simulator Configuration
# ------------------------------------------------------------------------------
QUANTUM_BACKEND=default.qubit
DEFAULT_QUBITS=8
DEFAULT_LAYERS=2
QUANTUM_SHOTS=1000
SIMULATOR_SHOTS=1024

# ------------------------------------------------------------------------------
# 6. Database Configuration
# ------------------------------------------------------------------------------
DATABASE_PATH=q-rakshak.db
QMED_REAL_DB_PATH=q-rakshak.db
QMED_DEMO_DB_PATH=q-rakshak_demo.db

# ------------------------------------------------------------------------------
# 7. Medical Foundation Models & Storage Caching (Optional / Gated)
# ------------------------------------------------------------------------------
# Device override: 'cuda', 'cpu', or leave blank for auto-detection
DEVICE=
# Hugging Face Access Token (required if downloading gated models like MedGemma)
HUGGINGFACE_HUB_TOKEN=
HF_TOKEN=
MODEL_CACHE_DIR=model_lab/artifacts/weights
EMBEDDING_CACHE_DIR=.cache/embeddings

# ------------------------------------------------------------------------------
# 8. Vapi Voice AI Doctor 1-on-1 Consultation
# ------------------------------------------------------------------------------
# Vapi API Private Key (for backend assistant provisioning)
VAPI_API_KEY=
# Vapi Public API Key (for frontend Web Call initialization)
VAPI_PUBLIC_KEY=
# Custom Pre-configured Vapi Assistant ID (optional)
VAPI_ASSISTANT_ID=
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
