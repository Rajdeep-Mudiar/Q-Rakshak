# ==============================================================================
# Q-RAKSHAK Backend API Gateway Environment Configuration Template
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
DEBUG=false

# Database Configuration
# Local SQLite: sqlite:///q-rakshak.db
# Production PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///q-rakshak.db
QMED_DB_MODE=production
QMED_REAL_DB_PATH=q-rakshak.db
QMED_DEMO_DB_PATH=q-rakshak_demo.db

# Authentication, Secrets & JWT Security
SECRET_KEY=replace-with-a-64-character-cryptographic-random-secret-key
JWT_SECRET=replace-with-a-64-character-cryptographic-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
API_KEY=replace-with-a-cryptographically-random-api-key

# CORS Configuration (Comma-separated allowed origins without trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://q-rakshak.health,https://www.q-rakshak.health,https://app.q-rakshak.health
CORS_ALLOW_CREDENTIALS=true
CORS_ORIGIN_REGEX=

# Model Inference Microservice Communication
MODEL_SERVICE_URL=http://model:8001
MODEL_SERVICE_API_KEY=replace-with-a-cryptographically-random-service-key
MODEL_SERVICE_TIMEOUT_SECONDS=45

# Frontend Web Origin (Used for email alerts, QR verification, WebRTC signaling)
FRONTEND_URL=https://q-rakshak.health

# Quantum Engine Simulation Fallback (When executing in-process)
QUANTUM_BACKEND=simulator
SIMULATOR_SHOTS=1024

# Rate Limiting
RATE_LIMIT_INFERENCE_MAX_PER_MINUTE=60
RATE_LIMIT_AUTH_MAX_PER_MINUTE=10

# Storage & Uploads
REPORTS_DIR=storage/reports
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=50
